APP_NAME="Nest App"
NODE_ENV=development
APP_PORT=3000

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# Set to false on instances that should only serve HTTP and not process queue jobs.
QUEUE_WORKER_ENABLED=true

# --- MySQL -----------------------------------------------------------------
# Hosts below are for running the API on your machine; docker-compose overrides them.
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=nest_v11_app
MYSQL_DB_USERNAME=root
MYSQL_DB_PASSWORD=<chage-me>
MYSQL_DB_POOL_SIZE=10
# Enable for managed MySQL (RDS, Cloud SQL, ...). Uses full certificate validation.
MYSQL_DB_SSL=false
# Used only by docker-compose to initialise the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root

# --- Redis -----------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# --- Mail ------------------------------------------------------------------
# smtp = real delivery (Mailtrap), json = log-only (tests)
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Helpdesk <no-reply@helpdesk.local>"